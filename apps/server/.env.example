# Server Configuration
NODE_ENV=development
PORT=3000

# Session
# Generate one with: openssl rand -base64 48
SESSION_COOKIE_SECRET=change-me

# Lightweight operator dashboard login.
ADMIN_PASSWORD=tenfour

# Game Storage: 'file' or 'redis'
GAME_STORE=file
# Production file storage is ephemeral and requires explicit acknowledgement:
# ALLOW_FILE_GAME_STORE=true

# Redis (only needed if GAME_STORE=redis)
REDIS_URL=redis://localhost:6379

# Durable game transcripts (optional outside production)
DATABASE_URL=postgresql://hanabi:hanabi@localhost:54329/hanabi

# URL Configuration (optional)
DOMAIN_BASE=http://localhost:3000
REDIRECT_URL_PROTOCOL_AND_SUBDOMAIN=

# Server-run bots. Keep the key server-only; never prefix it with VITE_.
HANABI_BOTS_ENABLED=false
OPENAI_API_KEY=
HANABI_BOT_MODEL=gpt-5.6-sol
HANABI_BOT_REASONING_EFFORT=medium
HANABI_BOT_TIMEOUT_MS=120000
HANABI_BOT_MAX_OUTPUT_TOKENS=16384
HANABI_BOT_MAX_CONCURRENT=3
HANABI_BOT_ROUND_MAX_ATTEMPTS=200
HANABI_BOT_ROUND_MAX_TOKENS=2000000
HANABI_BOT_GLOBAL_WINDOW_MS=3600000
HANABI_BOT_GLOBAL_MAX_ATTEMPTS=500
HANABI_BOT_GLOBAL_MAX_TOKENS=5000000
